---
// Human Library Book Cover Generator
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Human Library Book Cover Generator</title>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.7.0/p5.min.js"
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Lora:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --cream: #faf9f5;
        --warm-white: #f5f3ee;
        --charcoal: #2a2a28;
        --mid-gray: #b0aea5;
        --light-gray: #e8e6dc;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Poppins", sans-serif;
        background: linear-gradient(
          135deg,
          var(--cream) 0%,
          var(--warm-white) 100%
        );
        min-height: 100vh;
        color: var(--charcoal);
      }

      .container {
        display: flex;
        min-height: 100vh;
        padding: 20px;
        gap: 20px;
      }

      .sidebar {
        width: 380px;
        flex-shrink: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        padding: 24px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(20, 20, 19, 0.1);
        overflow-y: auto;
      }

      .sidebar h1 {
        font-family: "Lora", serif;
        font-size: 22px;
        font-weight: 500;
        color: var(--charcoal);
        margin-bottom: 6px;
      }

      .sidebar .subtitle {
        color: var(--mid-gray);
        font-size: 13px;
        margin-bottom: 28px;
        line-height: 1.4;
      }

      .control-section {
        margin-bottom: 28px;
      }

      .control-section h3 {
        font-size: 14px;
        font-weight: 600;
        color: var(--charcoal);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .control-section h3::before {
        content: "•";
        color: #d97757;
        font-weight: bold;
      }

      .control-group {
        margin-bottom: 16px;
      }

      .control-group label {
        display: block;
        font-size: 13px;
        font-weight: 500;
        color: var(--charcoal);
        margin-bottom: 6px;
      }

      .control-group input[type="text"],
      .control-group textarea {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--light-gray);
        border-radius: 8px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        background: var(--cream);
        color: var(--charcoal);
        transition: all 0.2s;
      }

      .control-group textarea {
        resize: vertical;
        min-height: 120px;
        line-height: 1.5;
      }

      .control-group input:focus,
      .control-group textarea:focus {
        outline: none;
        border-color: #d97757;
        background: white;
        box-shadow: 0 0 0 2px rgba(217, 119, 87, 0.1);
      }

      .char-count {
        font-size: 11px;
        color: var(--mid-gray);
        text-align: right;
        margin-top: 4px;
      }

      .slider-container {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .slider-container input[type="range"] {
        flex: 1;
        height: 4px;
        background: var(--light-gray);
        border-radius: 2px;
        outline: none;
        -webkit-appearance: none;
      }

      .slider-container input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 16px;
        height: 16px;
        background: #d97757;
        border-radius: 50%;
        cursor: pointer;
      }

      .value-display {
        font-family: "Courier New", monospace;
        font-size: 12px;
        color: var(--mid-gray);
        min-width: 40px;
        text-align: right;
      }

      .control-group select {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--light-gray);
        border-radius: 8px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        background: var(--cream);
        color: var(--charcoal);
        cursor: pointer;
        transition: all 0.2s;
      }

      .control-group select:focus {
        outline: none;
        border-color: #d97757;
        background: white;
      }

      .toggle-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        font-size: 13px;
      }

      .toggle-label input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: #d97757;
        cursor: pointer;
      }

      .button-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .button {
        flex: 1;
        padding: 10px 16px;
        border: none;
        border-radius: 8px;
        font-family: "Poppins", sans-serif;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        background: var(--light-gray);
        color: var(--charcoal);
      }

      .button:hover {
        background: #d9d7ce;
      }

      .button.primary {
        background: #d97757;
        color: white;
      }

      .button.primary:hover {
        background: #c86641;
      }

      .canvas-area {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 12px;
        padding: 20px;
      }

      #canvas-container {
        background: white;
        border-radius: 8px;
        box-shadow: 0 20px 60px rgba(20, 20, 19, 0.15);
        overflow: hidden;
      }

      .seed-display {
        font-family: "Courier New", monospace;
        font-size: 11px;
        color: var(--mid-gray);
        margin-top: 8px;
        text-align: center;
      }

      .hint {
        font-size: 11px;
        color: var(--mid-gray);
        margin-top: 10px;
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="sidebar">
        <h1>Human Library</h1>
        <p class="subtitle">
          Book Cover Generator — Each story gets a unique visual fingerprint
        </p>

        <div class="control-section">
          <h3>Book Content</h3>

          <div class="control-group">
            <label>Title</label>
            <input
              type="text"
              id="title-input"
              value="The Turncoat"
              maxlength="80"
              oninput="regenerate()"
            />
          </div>

          <div class="control-group">
            <label>Blurb</label>
            <textarea
              id="blurb-input"
              maxlength="1200"
              oninput="
                updateCharCount();
                regenerate();
              "
            >
              Leaving my faith wasn't a clean break; it was a long corridor of
              questions. I'll talk about skepticism, the social cost of naming
              myself an atheist, and the ways polarization reshapes families and
              friendships.</textarea
            >
            <div class="char-count"><span id="char-count">0</span>/1200</div>
          </div>
        </div>

        <div class="control-section">
          <h3>Layout</h3>

          <div class="control-group">
            <label>Aspect Ratio</label>
            <select id="aspectRatio" onchange="updateAspectRatio()">
              <option value="1:1">1:1 (Square)</option>
              <option value="3:2" selected>3:2 (Rectangular - Print)</option>
              <option value="4:5">4:5 (Instagram Portrait)</option>
              <option value="9:16">9:16 (Stories)</option>
            </select>
          </div>

          <div class="control-group">
            <label class="toggle-label">
              <input
                type="checkbox"
                id="dynamicHeight"
                onchange="updateAspectRatio()"
              />
              <span>Dynamic height (fit content)</span>
            </label>
          </div>

          <div class="control-group">
            <label>Extra Bottom Space</label>
            <div class="slider-container">
              <input
                type="range"
                id="extraSpace"
                min="0"
                max="0.6"
                step="0.05"
                value="0"
                oninput="updateParam('extraSpace', this.value)"
              />
              <span class="value-display" id="extraSpace-value">0%</span>
            </div>
          </div>

          <div class="control-group">
            <label>Shape Count</label>
            <div class="slider-container">
              <input
                type="range"
                id="shapeCount"
                min="4"
                max="12"
                step="1"
                value="6"
                oninput="updateParam('shapeCount', this.value)"
              />
              <span class="value-display" id="shapeCount-value">6</span>
            </div>
          </div>

          <div class="control-group">
            <label>Shape Size</label>
            <div class="slider-container">
              <input
                type="range"
                id="shapeSize"
                min="0.5"
                max="2"
                step="0.1"
                value="1"
                oninput="updateParam('shapeSize', this.value)"
              />
              <span class="value-display" id="shapeSize-value">1.0</span>
            </div>
          </div>

          <div class="control-group">
            <label>Wobble</label>
            <div class="slider-container">
              <input
                type="range"
                id="wobble"
                min="0"
                max="1"
                step="0.1"
                value="0.4"
                oninput="updateParam('wobble', this.value)"
              />
              <span class="value-display" id="wobble-value">0.4</span>
            </div>
          </div>

          <div class="control-group">
            <label>Shape Area %</label>
            <div class="slider-container">
              <input
                type="range"
                id="shapeArea"
                min="0.1"
                max="0.8"
                step="0.05"
                value="0.2"
                oninput="updateParam('shapeArea', this.value)"
              />
              <span class="value-display" id="shapeArea-value">20%</span>
            </div>
          </div>
        </div>

        <div class="control-section">
          <h3>Actions</h3>
          <div class="button-row">
            <button class="button" onclick="resetDefaults()">Reset</button>
            <button class="button primary" onclick="downloadCanvas()">
              Download
            </button>
            <button class="button" onclick="downloadSvg()">Download SVG</button>
          </div>
          <div class="seed-display">Seed: <span id="seed-display">0</span></div>
        </div>
      </div>

      <div class="canvas-area">
        <div id="canvas-container"></div>
      </div>
    </div>

    <script is:inline>
      // Warm palette - terracotta, pink, coral focused
      const PALETTE = [
        "#E07A5F", // Terra cotta
        "#D4726A", // Dusty rose
        "#E88D7A", // Coral
        "#C9787C", // Muted pink
        "#D4956A", // Warm peach
        "#E6A07A", // Soft coral
        "#C97B7B", // Rose
        "#D98B6A", // Salmon terracotta
      ];

      const BACKGROUND = "#FAF8F5";
      const TEXT_COLOR = "#2A2A28";
      const EXPORT_SCALE = 4;
      const measureContext = document
        .createElement("canvas")
        .getContext("2d");

      let params = {
        shapeCount: 6,
        shapeSize: 1.0,
        wobble: 0.4,
        shapeArea: 0.2,
        extraSpace: 0,
      };

      let currentSeed = 0;

      // Hash function: convert blurb to seed number
      function hashString(str) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
          const char = str.charCodeAt(i);
          hash = (hash << 5) - hash + char;
          hash = hash & hash;
        }
        return Math.abs(hash);
      }

      // Seeded random using mulberry32
      function createSeededRandom(seed) {
        return function () {
          let t = (seed += 0x6d2b79f5);
          t = Math.imul(t ^ (t >>> 15), t | 1);
          t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      let seededRandom;

      function setup() {
        let canvas = createCanvas(400, 400);
        canvas.parent("canvas-container");
        noLoop();
        updateCharCount();
        regenerate();
      }

      function regenerate() {
        const blurb = document.getElementById("blurb-input").value;
        currentSeed = hashString(blurb);
        document.getElementById("seed-display").textContent = currentSeed;

        seededRandom = createSeededRandom(currentSeed);
        calculateAndResize();
        redraw();
      }

      function calculateAndResize() {
        const title =
          document.getElementById("title-input").value || "Untitled";
        const blurb = document.getElementById("blurb-input").value || "";
        const aspectRatio = document.getElementById("aspectRatio").value;
        const dynamicHeight = document.getElementById("dynamicHeight").checked;

        // Adjust canvas width based on aspect ratio
        let canvasWidth = 400;
        if (aspectRatio === "3:2") {
          canvasWidth = 600; // Wider for Notion Gallery
        }

        let canvasHeight;

        // Calculate aspect ratio height
        const ratios = {
          "1:1": 1,
          "3:2": 2 / 3,
          "4:5": 5 / 4,
          "9:16": 16 / 9,
        };
        const ratioHeight = canvasWidth * ratios[aspectRatio];

        if (dynamicHeight) {
          // Calculate text zone height with correct sizing
          const padding = 24;
          const maxTextWidth = canvasWidth - padding * 2;

          textFont("Lora");
          textSize(24);
          const titleLines = wrapText(title, maxTextWidth);
          const titleHeight = titleLines.length * 30;

          textFont("Poppins");
          textSize(13);
          const blurbLines = wrapText(blurb, maxTextWidth);
          const blurbHeight = blurbLines.length * 19;

          // Text zone needs: fade overlap (20) + title + gaps + blurb + branding space
          const textZoneHeight = 20 + titleHeight + 8 + 10 + blurbHeight + 30;

          // Total canvas height based on shape area percentage
          // If shapeArea is 40%, text gets 60%, so: textZoneHeight / (1 - shapeArea)
          canvasHeight = textZoneHeight / (1 - params.shapeArea);
        } else {
          canvasHeight = ratioHeight;
        }

        canvasHeight *= 1 + params.extraSpace;

        const roundedWidth = Math.max(1, Math.round(canvasWidth));
        const roundedHeight = Math.max(1, Math.round(canvasHeight));
        resizeCanvas(roundedWidth, roundedHeight);
      }

      function updateAspectRatio() {
        regenerate();
      }

      function draw() {
        // Reset seed at start of every draw
        seededRandom = createSeededRandom(currentSeed);

        const title =
          document.getElementById("title-input").value || "Untitled";
        const blurb = document.getElementById("blurb-input").value || "";

        renderCover(window, title, blurb, 1);
      }

      function renderCover(g, title, blurb, scale) {
        const layoutWidth = g.width;
        const layoutHeight = g.height;

        g.background(BACKGROUND);
        drawShapes(g, layoutWidth, layoutHeight, scale);
        drawTextZone(g, title, blurb, layoutWidth, layoutHeight, scale);
      }

      function drawShapes(g, layoutWidth, layoutHeight, scale) {
        // Use the shapeArea parameter to control how much of the canvas shapes occupy
        const safeZoneHeight = layoutHeight * params.shapeArea;

        const count = params.shapeCount;
        const baseSize = 22 * params.shapeSize * scale;
        const wobbleAmount = params.wobble;

        const topMargin = 15 * scale;
        const sideMargin = 20 * scale;

        // Divide canvas into zones for better distribution
        const zones = [];
        const zoneCols = 3;
        const zoneRows = 2;
        const zoneWidth = (layoutWidth - sideMargin * 2) / zoneCols;
        const zoneHeight = (safeZoneHeight - topMargin) / zoneRows;

        for (let row = 0; row < zoneRows; row++) {
          for (let col = 0; col < zoneCols; col++) {
            zones.push({
              x: sideMargin + col * zoneWidth,
              y: topMargin + row * zoneHeight,
              w: zoneWidth,
              h: zoneHeight,
            });
          }
        }

        // Shuffle zones based on seed
        for (let i = zones.length - 1; i > 0; i--) {
          const j = Math.floor(seededRandom() * (i + 1));
          [zones[i], zones[j]] = [zones[j], zones[i]];
        }

        for (let i = 0; i < count; i++) {
          const zone = zones[i % zones.length];

          const x = zone.x + seededRandom() * zone.w;
          const y = zone.y + seededRandom() * zone.h;

          const size = baseSize + seededRandom() * baseSize * 1.0;

          const colorIndex = Math.floor(seededRandom() * PALETTE.length);
          const col = g.color(PALETTE[colorIndex]);
          col.setAlpha(90 + seededRandom() * 60);

          drawBlob(g, x, y, size, wobbleAmount, col);
        }
      }

      function drawBlob(g, x, y, size, wobbleAmount, col) {
        g.noStroke();
        g.fill(col);

        // Create organic blob using bezier curves
        const points = 8;
        const angleStep = TWO_PI / points;

        g.beginShape();
        for (let i = 0; i <= points; i++) {
          const angle = i * angleStep;
          const wobble = 1 + (seededRandom() - 0.5) * wobbleAmount * 0.6;
          const r = size * wobble;

          const px = x + cos(angle) * r;
          const py = y + sin(angle) * r;

          if (i === 0) {
            g.curveVertex(px, py);
            g.curveVertex(px, py);
          } else if (i === points) {
            g.curveVertex(px, py);
            g.curveVertex(px, py);
          } else {
            g.curveVertex(px, py);
          }
        }
        g.endShape(CLOSE);
      }

      function drawTextZone(g, title, blurb, layoutWidth, layoutHeight, scale) {
        const padding = 24 * scale;
        const maxTextWidth = layoutWidth - padding * 2;

        // Measure title
        g.textFont("Lora");
        g.textSize(24 * scale);
        const titleLines = wrapText(title, maxTextWidth, g);
        const titleLineHeight = 30 * scale;
        const titleHeight = titleLines.length * titleLineHeight;

        // Measure blurb
        g.textFont("Poppins");
        g.textSize(13 * scale);
        const blurbLines = wrapText(blurb, maxTextWidth, g);
        const blurbLineHeight = 19 * scale;
        const blurbHeight = blurbLines.length * blurbLineHeight;

        // Text zone starts right after the shape area
        const textZoneStart = layoutHeight * params.shapeArea;

        // Calculate positions from the text zone start
        const fadeStart = textZoneStart;
        const fadeHeight = 40 * scale;
        const fadeEnd = fadeStart + fadeHeight;
        // Title starts within the fade (20px into fade region)
        const titleStartY = fadeStart + 20 * scale;
        const titleEndY = titleStartY + titleHeight;
        const dividerY = titleEndY + 8 * scale;
        const blurbStartY = dividerY + 10 * scale;
        const blurbEndY = blurbStartY + blurbHeight;

        // Branding at the bottom
        const bottomPadding = 15 * scale;
        const brandingY = 10 * scale + layoutHeight - bottomPadding;

        // Gradient fade
        g.noStroke();
        for (let i = 0; i < fadeHeight; i++) {
          const y = fadeStart + i;
          const alpha = map(i, 0, fadeHeight, 0, 255);
          g.fill(250, 248, 245, alpha);
          g.rect(0, y, layoutWidth, 1);
        }

        // Solid background below fade
        g.fill(BACKGROUND);
        g.rect(0, fadeEnd, layoutWidth, layoutHeight - fadeEnd);

        // Title
        g.fill(TEXT_COLOR);
        g.textFont("Lora");
        g.textStyle(NORMAL);
        g.textSize(24 * scale);
        g.textAlign(LEFT, TOP);

        let titleY = titleStartY;
        for (const line of titleLines) {
          g.text(line, padding, titleY);
          titleY += titleLineHeight;
        }

        // Divider
        g.stroke(TEXT_COLOR);
        g.strokeWeight(1);
        g.line(padding, dividerY, padding + 40 * scale, dividerY);

        // Blurb — render line-by-line using pre-wrapped lines so we don't
        // depend on p5's internal wrap + bounding-box clipping, which clips
        // text at higher export scales.
        g.noStroke();
        g.fill(TEXT_COLOR);
        g.textFont("Poppins");
        g.textSize(13 * scale);
        g.textLeading(blurbLineHeight);
        g.textAlign(LEFT, TOP);

        let blurbY = blurbStartY;
        for (const line of blurbLines) {
          g.text(line, padding, blurbY);
          blurbY += blurbLineHeight;
        }

        // Branding - pinned to bottom
        g.fill(150);
        g.textSize(9 * scale);
        g.textAlign(LEFT, BOTTOM);
        g.text("LIVING STORIES COLLECTIVE", padding, brandingY);
      }

      function flattenBackground(g, colorValue) {
        const ctx = g.drawingContext;
        ctx.save();
        ctx.globalCompositeOperation = "destination-over";
        ctx.fillStyle = colorValue;
        ctx.fillRect(0, 0, g.width, g.height);
        ctx.restore();
      }

      // Helper function to wrap text — honors explicit newlines in the source
      function wrapText(txt, maxWidth, g = window) {
        const paragraphs = txt.split("\n");
        const lines = [];

        for (const paragraph of paragraphs) {
          if (paragraph === "") {
            lines.push("");
            continue;
          }

          const words = paragraph.split(" ");
          let currentLine = "";

          for (const word of words) {
            const testLine = currentLine ? currentLine + " " + word : word;
            const testWidth = g.textWidth(testLine);

            if (testWidth > maxWidth && currentLine) {
              lines.push(currentLine);
              currentLine = word;
            } else {
              currentLine = testLine;
            }
          }

          if (currentLine) {
            lines.push(currentLine);
          }
        }

        return lines.length > 0 ? lines : [""];
      }

      function escapeXml(text) {
        return text
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function hexToRgb(hex) {
        const normalized = hex.replace("#", "");
        const value =
          normalized.length === 3
            ? normalized
                .split("")
                .map((char) => char + char)
                .join("")
            : normalized;
        const r = parseInt(value.slice(0, 2), 16);
        const g = parseInt(value.slice(2, 4), 16);
        const b = parseInt(value.slice(4, 6), 16);
        return { r, g, b };
      }

      function textWidthForFont(text, font) {
        measureContext.font = font;
        return measureContext.measureText(text).width;
      }

      function fontMetrics(font, fontSize) {
        measureContext.font = font;
        const metrics = measureContext.measureText("Mg");
        const ascent =
          metrics.actualBoundingBoxAscent || Math.round(fontSize * 0.8);
        const descent =
          metrics.actualBoundingBoxDescent || Math.round(fontSize * 0.2);
        return { ascent, descent };
      }

      function generateSvgMarkup({
        width,
        height,
        title,
        blurb,
        scale,
        seed,
      }) {
        seededRandom = createSeededRandom(seed);

        const clipId = `clip-${seed}`;

        const padding = 24 * scale;
        const maxTextWidth = width - padding * 2;
        const titleFontSize = 24 * scale;
        const titleLineHeight = 30 * scale;
        const blurbFontSize = 13 * scale;
        const blurbLineHeight = 19 * scale;
        const brandingFontSize = 9 * scale;

        const titleFont = `400 ${titleFontSize}px Lora`;
        const blurbFont = `400 ${blurbFontSize}px Poppins`;
        const brandingFont = `400 ${brandingFontSize}px Poppins`;

        const titleMetrics = fontMetrics(titleFont, titleFontSize);
        const blurbMetrics = fontMetrics(blurbFont, blurbFontSize);
        const brandingMetrics = fontMetrics(brandingFont, brandingFontSize);

        const titleLines = wrapText(title, maxTextWidth, {
          textWidth: (text) => textWidthForFont(text, titleFont),
        });
        const titleHeight = titleLines.length * titleLineHeight;

        const blurbLines = wrapText(blurb, maxTextWidth, {
          textWidth: (text) => textWidthForFont(text, blurbFont),
        });
        const blurbHeight = blurbLines.length * blurbLineHeight;

        const textZoneStart = height * params.shapeArea;
        const fadeStart = textZoneStart;
        const fadeHeight = 40 * scale;
        const fadeEnd = fadeStart + fadeHeight;
        const titleStartY = fadeStart + 20 * scale;
        const titleEndY = titleStartY + titleHeight;
        const dividerY = titleEndY + 8 * scale;
        const blurbStartY = dividerY + 10 * scale;
        const bottomPadding = 15 * scale;
        const brandingY = 15 * scale + height - bottomPadding;

        const titleBaseline = titleStartY + titleMetrics.ascent;
        const blurbBaseline = blurbStartY + blurbMetrics.ascent;
        const brandingBaseline = brandingY - brandingMetrics.descent;

        const safeZoneHeight = height * params.shapeArea;
        const count = params.shapeCount;
        const baseSize = 22 * params.shapeSize * scale;
        const wobbleAmount = params.wobble;
        const topMargin = 15 * scale;
        const sideMargin = 20 * scale;
        const zoneCols = 3;
        const zoneRows = 2;
        const zoneWidth = (width - sideMargin * 2) / zoneCols;
        const zoneHeight = (safeZoneHeight - topMargin) / zoneRows;

        const zones = [];
        for (let row = 0; row < zoneRows; row++) {
          for (let col = 0; col < zoneCols; col++) {
            zones.push({
              x: sideMargin + col * zoneWidth,
              y: topMargin + row * zoneHeight,
              w: zoneWidth,
              h: zoneHeight,
            });
          }
        }

        for (let i = zones.length - 1; i > 0; i--) {
          const j = Math.floor(seededRandom() * (i + 1));
          [zones[i], zones[j]] = [zones[j], zones[i]];
        }

        const parts = [];
        const fadeId = `fade-${seed}`;
        const maskId = `mask-${seed}`;
        parts.push(
          `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}">`
        );
        parts.push("<defs>");
        parts.push(
          `<linearGradient id="${fadeId}" gradientUnits="userSpaceOnUse" x1="0" y1="${fadeStart}" x2="0" y2="${fadeEnd}">`
        );
        parts.push(`<stop offset="0%" stop-color="white" />`);
        parts.push(`<stop offset="100%" stop-color="black" />`);
        parts.push("</linearGradient>");
        parts.push(
          `<clipPath id="${clipId}"><rect x="0" y="0" width="${width}" height="${height}" /></clipPath>`
        );
        parts.push(
          `<mask id="${maskId}"><rect x="0" y="0" width="${width}" height="${height}" fill="white" /><rect x="0" y="${fadeStart}" width="${width}" height="${fadeHeight}" fill="url(#${fadeId})" /><rect x="0" y="${fadeEnd}" width="${width}" height="${
            height - fadeEnd
          }" fill="black" /></mask>`
        );
        parts.push("</defs>");

        parts.push(
          `<rect x="0" y="0" width="${width}" height="${height}" fill="${BACKGROUND}" />`
        );
        parts.push(`<g clip-path="url(#${clipId})">`);

        for (let i = 0; i < count; i++) {
          const zone = zones[i % zones.length];
          const x = zone.x + seededRandom() * zone.w;
          const y = zone.y + seededRandom() * zone.h;
          const size = baseSize + seededRandom() * baseSize * 1.0;
          const colorIndex = Math.floor(seededRandom() * PALETTE.length);
          const { r, g, b } = hexToRgb(PALETTE[colorIndex]);
          const alpha = (90 + seededRandom() * 60) / 255;
          const points = 28;
          const angleStep = (Math.PI * 2) / points;
          const blobPoints = [];

          for (let j = 0; j < points; j++) {
            const angle = j * angleStep;
            const wobble = 1 + (seededRandom() - 0.5) * wobbleAmount * 0.6;
            const rVal = size * wobble;
            blobPoints.push({
              x: x + Math.cos(angle) * rVal,
              y: y + Math.sin(angle) * rVal,
            });
          }

          let path = `M ${blobPoints[0].x.toFixed(2)} ${blobPoints[0].y.toFixed(
            2
          )}`;
          for (let j = 0; j < blobPoints.length; j++) {
            const p0 = blobPoints[(j - 1 + points) % points];
            const p1 = blobPoints[j % points];
            const p2 = blobPoints[(j + 1) % points];
            const p3 = blobPoints[(j + 2) % points];

            const c1x = p1.x + (p2.x - p0.x) / 6;
            const c1y = p1.y + (p2.y - p0.y) / 6;
            const c2x = p2.x - (p3.x - p1.x) / 6;
            const c2y = p2.y - (p3.y - p1.y) / 6;

            path += ` C ${c1x.toFixed(2)} ${c1y.toFixed(2)} ${c2x.toFixed(
              2
            )} ${c2y.toFixed(2)} ${p2.x.toFixed(2)} ${p2.y.toFixed(2)}`;
          }
          path += " Z";
          parts.push(
            `<path d="${path}" fill="rgb(${r}, ${g}, ${b})" fill-opacity="${alpha.toFixed(
              3
            )}" />`
          );
        }

        parts.push("</g>");
        parts.push(`<g clip-path="url(#${clipId})" mask="url(#${maskId})">`);
        parts.push(
          `<rect x="0" y="0" width="${width}" height="${height}" fill="${BACKGROUND}" />`
        );
        parts.push("</g>");

        parts.push(
          `<text x="${padding}" y="${titleBaseline}" font-family="Lora" font-size="${titleFontSize}" font-weight="400" fill="${TEXT_COLOR}">`
        );
        titleLines.forEach((line, index) => {
          const dy = index === 0 ? 0 : titleLineHeight;
          parts.push(
            `<tspan x="${padding}" dy="${dy}">${escapeXml(line)}</tspan>`
          );
        });
        parts.push("</text>");

        parts.push(
          `<line x1="${padding}" y1="${dividerY}" x2="${
            padding + 40 * scale
          }" y2="${dividerY}" stroke="${TEXT_COLOR}" stroke-width="${
            1 * scale
          }" />`
        );

        parts.push(
          `<text x="${padding}" y="${blurbBaseline}" font-family="Poppins" font-size="${blurbFontSize}" font-weight="400" fill="${TEXT_COLOR}">`
        );
        blurbLines.forEach((line, index) => {
          const dy = index === 0 ? 0 : blurbLineHeight;
          parts.push(
            `<tspan x="${padding}" dy="${dy}">${escapeXml(line)}</tspan>`
          );
        });
        parts.push("</text>");

        parts.push(
          `<text x="${padding}" y="${brandingBaseline}" font-family="Poppins" font-size="${brandingFontSize}" font-weight="400" fill="#969696">LIVING STORIES COLLECTIVE</text>`
        );

        parts.push("</svg>");
        return parts.join("");
      }

      function updateParam(paramName, value) {
        params[paramName] = parseFloat(value);
        if (paramName === "shapeCount") {
          document.getElementById(paramName + "-value").textContent = value;
        } else if (paramName === "shapeArea") {
          document.getElementById(paramName + "-value").textContent =
            (parseFloat(value) * 100).toFixed(0) + "%";
        } else if (paramName === "extraSpace") {
          document.getElementById(paramName + "-value").textContent =
            (parseFloat(value) * 100).toFixed(0) + "%";
        } else {
          document.getElementById(paramName + "-value").textContent =
            parseFloat(value).toFixed(1);
        }
        regenerate();
      }

      function updateCharCount() {
        const count = document.getElementById("blurb-input").value.length;
        document.getElementById("char-count").textContent = count;
      }

      function resetDefaults() {
        params = {
          shapeCount: 6,
          shapeSize: 1.0,
          wobble: 0.4,
          shapeArea: 0.2,
          extraSpace: 0,
        };

        document.getElementById("shapeCount").value = 6;
        document.getElementById("shapeCount-value").textContent = "6";
        document.getElementById("shapeSize").value = 1.0;
        document.getElementById("shapeSize-value").textContent = "1.0";
        document.getElementById("wobble").value = 0.4;
        document.getElementById("wobble-value").textContent = "0.4";
        document.getElementById("shapeArea").value = 0.2;
        document.getElementById("shapeArea-value").textContent = "20%";
        document.getElementById("extraSpace").value = 0;
        document.getElementById("extraSpace-value").textContent = "0%";

        regenerate();
      }

      // Generate sanitized filename from title and seed
      function generateFilename() {
        const title =
          document.getElementById("title-input").value || "Untitled";
        const safeName = title
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");
        return `human-library-${safeName}-${currentSeed}`;
      }

      // Download canvas as PNG
      function downloadCanvas() {
        const canvas = document.querySelector("#canvas-container canvas");
        if (!canvas) {
          console.error("Canvas not found");
          return;
        }

        const filename = `${generateFilename()}.png`;
        const exportWidth = Math.round(width * EXPORT_SCALE);
        const exportHeight = Math.round(height * EXPORT_SCALE);
        const exportGraphics = createGraphics(exportWidth, exportHeight);
        exportGraphics.pixelDensity(1);

        seededRandom = createSeededRandom(currentSeed);
        const title =
          document.getElementById("title-input").value || "Untitled";
        const blurb = document.getElementById("blurb-input").value || "";
        renderCover(exportGraphics, title, blurb, EXPORT_SCALE);
        flattenBackground(exportGraphics, BACKGROUND);

        const exportCanvas = document.createElement("canvas");
        exportCanvas.width = exportWidth;
        exportCanvas.height = exportHeight;
        const exportContext = exportCanvas.getContext("2d", { alpha: false });
        exportContext.imageSmoothingEnabled = true;
        exportContext.fillStyle = BACKGROUND;
        exportContext.fillRect(0, 0, exportWidth, exportHeight);
        exportContext.drawImage(exportGraphics.canvas, 0, 0);

        exportCanvas.toBlob((blob) => {
          exportGraphics.remove();

          if (!blob) {
            console.error("Failed to create image blob");
            return;
          }

          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = filename;
          document.body.appendChild(link);
          link.click();

          // Cleanup
          setTimeout(() => {
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
          }, 100);
        }, "image/png");
      }

      // Download vector SVG (best for print workflows)
      function downloadSvg() {
        const filename = `${generateFilename()}.svg`;
        const exportWidth = Math.round(width * EXPORT_SCALE);
        const exportHeight = Math.round(height * EXPORT_SCALE);
        const title =
          document.getElementById("title-input").value || "Untitled";
        const blurb = document.getElementById("blurb-input").value || "";
        const svgString = generateSvgMarkup({
          width: exportWidth,
          height: exportHeight,
          title,
          blurb,
          scale: EXPORT_SCALE,
          seed: currentSeed,
        });

        const blob = new Blob([svgString], {
          type: "image/svg+xml;charset=utf-8",
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();

        setTimeout(() => {
          document.body.removeChild(link);
          URL.revokeObjectURL(url);
        }, 100);
      }
    </script>
  </body>
</html>
