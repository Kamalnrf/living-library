---
export const prerender = false;
import RegisterWizard from '../components/register/RegisterWizard';
import {REGISTER_PAGE_TITLE} from '../utils/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{REGISTER_PAGE_TITLE}</title>
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloria+Hallelujah&family=Inter:wght@400;500;600&family=Lora:wght@400;500;600&family=Poppins:wght@400;500&family=Sometype+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <RegisterWizard client:load />
  </body>
</html>
