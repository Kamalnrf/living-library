---
export const prerender = false

import LandingPageShell from '../layouts/LandingPageShell.astro'
import LandingFeedback from '../components/landing/LandingFeedback.astro'
import LandingFooter from '../components/landing/LandingFooter.astro'
import LandingGetInvolved from '../components/landing/LandingGetInvolved.astro'
import LandingHeader from '../components/landing/LandingHeader.astro'
import LandingHero from '../components/landing/LandingHero.astro'
import LandingHowItWorks from '../components/landing/LandingHowItWorks.astro'
import LandingUpcomingSessions from '../components/landing/LandingUpcomingSessions.astro'
import {HOME_DESCRIPTION, HOME_TITLE} from '../utils/site'

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, must-revalidate, s-maxage=604800, stale-while-revalidate=2592000',
)
---

<LandingPageShell
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
>
  <LandingHeader slot="header" />

  <LandingHero />
  <LandingUpcomingSessions />
  <LandingHowItWorks />
  <LandingFeedback />
  <LandingGetInvolved />
  <LandingFooter slot="footer" />
</LandingPageShell>
