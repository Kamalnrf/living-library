---
import type { EditorialQuoteGridBlock as EditorialQuoteGridBlockData } from "./editorialSection";

interface Props {
  block: EditorialQuoteGridBlockData;
  class?: string;
}

const { block, class: className } = Astro.props as Props;
---

<div
  class:list={["editorial-quote-grid-block", className]}
  data-editorial-block-kind="quote-grid"
  data-editorial-quote-count={block.quotes.length}
>
  {
    block.quotes.map((quote, index) => (
      <article
        class="editorial-quote-grid-card"
        data-editorial-quote-id={quote.id}
        data-editorial-quote-index={index + 1}
      >
        <blockquote class="editorial-quote-grid-card__quote">
          <p>{quote.quote}</p>
        </blockquote>
        <p class="editorial-quote-grid-card__supporting">
          {quote.supportingCopy}
        </p>
      </article>
    ))
  }
</div>

<style>
  .editorial-quote-grid-block {
    display: flex;
    min-height: 300px;
    border-bottom: 1px solid var(--editorial-color-divider);
  }

  .editorial-quote-grid-block > * {
    width: 50%;
  }

  .editorial-quote-grid-block > :first-child {
    border-right: 1px solid var(--editorial-color-divider);
  }

  .editorial-quote-grid-card {
    min-width: 0;
    padding: var(--editorial-panel-padding);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .editorial-quote-grid-card__quote,
  .editorial-quote-grid-card__quote p,
  .editorial-quote-grid-card__supporting {
    margin: 0;
  }

  .editorial-quote-grid-card__quote {
    width: 100%;
    max-width: 24ch;
    margin: auto;
    color: #2e2d28;
    font-family: var(--editorial-font-serif);
    font-size: clamp(26px, 2.5vw, 34px);
    font-weight: 400;
    line-height: 1.14;
    text-wrap: balance;
  }

  .editorial-quote-grid-card__supporting {
    color: #3e3d38;
    font-family: var(--editorial-font-sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 23px;
  }

  @media (max-width: 900px) {
    .editorial-quote-grid-block {
      min-height: 0;
      flex-direction: column;
    }

    .editorial-quote-grid-block > * {
      width: 100%;
    }

    .editorial-quote-grid-block > :first-child {
      border-right: 0;
      border-bottom: 1px solid var(--editorial-color-divider);
    }

    .editorial-quote-grid-card__quote {
      font-size: 27px;
      line-height: 1.16;
    }

    .editorial-quote-grid-card__supporting {
      font-size: 15px;
      line-height: 23px;
    }
  }
</style>
