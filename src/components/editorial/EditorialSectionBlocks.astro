---
import EditorialCardGridBlock from './EditorialCardGridBlock.astro'
import EditorialStoryRowBlock from './EditorialStoryRowBlock.astro'
import EditorialSplitBandBlock from './EditorialSplitBandBlock.astro'
import type {
  EditorialCardGridBlock as EditorialCardGridBlockData,
  EditorialSplitBandBlock as EditorialSplitBandBlockData,
  EditorialStoryRowBlock as EditorialStoryRowBlockData,
} from './editorialSection'

type SupportedEditorialBlock =
  | EditorialCardGridBlockData
  | EditorialSplitBandBlockData
  | EditorialStoryRowBlockData

interface Props {
  blocks: readonly SupportedEditorialBlock[]
  headingTag?: 'h2' | 'h3' | 'h4'
}

const {
  blocks,
  headingTag = 'h3',
} = Astro.props as Props
---

{
  blocks.map((block) => {
    if (block.kind === 'card-grid') {
      return <EditorialCardGridBlock block={block} headingTag={headingTag} />
    }

    if (block.kind === 'split-band') {
      return <EditorialSplitBandBlock block={block} headingTag={headingTag} />
    }

    if (block.kind === 'story-row') {
      return <EditorialStoryRowBlock block={block} headingTag={headingTag} />
    }

    return null
  })
}
