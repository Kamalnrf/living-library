---
import EditorialFrame from "../editorial/EditorialFrame.astro";
import EditorialSectionIntro from "../editorial/EditorialSectionIntro.astro";
import {
  CONTACT_EMAIL,
  PARTNER_INQUIRIES_API_URL,
} from "../../utils/site";
import { PARTNER_CONTACT_INTRO } from "./partnerWithUsData";
---

<EditorialFrame
  as="section"
  variant="section"
  id="partner-contact"
  class="partner-section partner-contact"
  aria-labelledby="partner-contact-title"
>
  <EditorialSectionIntro
    intro={PARTNER_CONTACT_INTRO}
    headingId="partner-contact-title"
  />

  <div class="partner-contact__body">
    <form
      class="partner-contact__form"
      action={`mailto:${CONTACT_EMAIL}`}
      method="post"
      enctype="text/plain"
      data-partner-contact-form
      data-contact-email={CONTACT_EMAIL}
      data-api-url={PARTNER_INQUIRIES_API_URL}
    >
      <div class="partner-contact__field">
        <label for="partner-contact-name">Your name</label>
        <input
          id="partner-contact-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="120"
          required
        />
      </div>

      <div class="partner-contact__field">
        <label for="partner-contact-organisation">Organisation</label>
        <input
          id="partner-contact-organisation"
          name="organisation"
          type="text"
          autocomplete="organization"
          maxlength="160"
          required
        />
      </div>

      <div class="partner-contact__field partner-contact__field--wide">
        <label for="partner-contact-email">Email address</label>
        <input
          id="partner-contact-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          maxlength="254"
          spellcheck="false"
          required
        />
      </div>

      <div class="partner-contact__field partner-contact__field--wide">
        <label for="partner-contact-message">Message</label>
        <textarea
          id="partner-contact-message"
          name="message"
          rows="6"
          maxlength="5000"
          required
        ></textarea>
      </div>

      <div class="partner-contact__honeypot" aria-hidden="true">
        <label for="partner-contact-fax">Fax number</label>
        <input
          id="partner-contact-fax"
          name="faxNumber"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>

      <div class="partner-contact__actions">
        <button type="submit">Send message</button>
        <p data-partner-contact-status data-state="idle" aria-live="polite">
          We’ll email you to confirm we received it.
        </p>
        <a data-partner-contact-fallback hidden>Email us instead</a>
      </div>
    </form>
  </div>
</EditorialFrame>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "[data-partner-contact-form]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-partner-contact-status]",
  );
  const submitButton = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );
  const fallbackLink = form?.querySelector<HTMLAnchorElement>(
    "[data-partner-contact-fallback]",
  );
  let idempotencyKey = crypto.randomUUID();

  form?.addEventListener("submit", async (event) => {
    if (!form.checkValidity()) {
      return;
    }

    event.preventDefault();
    if (fallbackLink) fallbackLink.hidden = true;

    const formData = new FormData(form);
    const name = String(formData.get("name") ?? "").trim();
    const organisation = String(formData.get("organisation") ?? "").trim();
    const email = String(formData.get("email") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();
    const faxNumber = String(formData.get("faxNumber") ?? "").trim();
    const contactEmail = form.dataset.contactEmail;
    const apiUrl = form.dataset.apiUrl;

    if (!name || !organisation || !email || !message) {
      if (status) {
        status.dataset.state = "error";
        status.textContent = "Please complete each field before sending.";
      }
      return;
    }

    const fallbackSubject = ["Partner session inquiry", organisation || name]
      .filter(Boolean)
      .join(" - ");
    const fallbackBody = [
      `Name: ${name}`,
      `Organisation: ${organisation}`,
      `Email: ${email}`,
      "",
      message,
    ].join("\n");
    if (fallbackLink) {
      fallbackLink.href = `mailto:${contactEmail ?? "mail@livingstoriescollective.org"}?subject=${encodeURIComponent(fallbackSubject)}&body=${encodeURIComponent(fallbackBody)}`;
    }

    if (!apiUrl) {
      if (status) {
        status.dataset.state = "error";
        status.textContent = `Please email us at ${contactEmail ?? "mail@livingstoriescollective.org"}.`;
      }
      if (fallbackLink) fallbackLink.hidden = false;
      return;
    }

    if (status) {
      status.dataset.state = "pending";
      status.textContent = "Sending your inquiry…";
    }
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Sending…";
    }
    form.setAttribute("aria-busy", "true");

    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 15_000);

    try {
      const response = await fetch(apiUrl, {
        method: "POST",
        credentials: "omit",
        signal: controller.signal,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name,
          organisation,
          email,
          message,
          faxNumber,
          idempotencyKey,
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(
          typeof result.error === "string" ? result.error : "Unable to send your inquiry.",
        );
      }

      form.reset();
      idempotencyKey = crypto.randomUUID();
      if (status) {
        status.dataset.state = "success";
        status.textContent = "Thank you — your inquiry has been received. We’ll email you a confirmation shortly.";
      }
    } catch (error) {
      if (status) {
        status.dataset.state = "error";
        status.textContent = error instanceof DOMException && error.name === "AbortError"
          ? "We couldn’t confirm receipt. Please press Send message again — it won’t create a duplicate."
          : `${
            error instanceof Error ? error.message : "We couldn’t send this right now."
          } Please try again, or email ${contactEmail ?? "mail@livingstoriescollective.org"}.`;
      }
      if (fallbackLink) fallbackLink.hidden = false;
    } finally {
      window.clearTimeout(timeout);
      form.removeAttribute("aria-busy");
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Send message";
      }
    }
  });
</script>

<style>
  :global(.partner-contact) {
    background: var(--editorial-color-surface-elevated);
    border: 1px solid var(--editorial-color-border);
  }

  .partner-contact__body {
    padding: var(--editorial-panel-padding);
  }

  .partner-contact__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .partner-contact__field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .partner-contact__field--wide,
  .partner-contact__actions {
    grid-column: 1 / -1;
  }

  .partner-contact__honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .partner-contact__field label {
    color: #8e8776;
    font-family: var(--editorial-font-sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 16px;
    text-transform: uppercase;
  }

  .partner-contact__field input,
  .partner-contact__field textarea {
    width: 100%;
    border: 1px solid var(--editorial-color-action-border);
    background: var(--editorial-color-surface-panel);
    color: var(--editorial-color-text);
    font: inherit;
    font-family: var(--editorial-font-sans);
    font-size: 17px;
    line-height: 24px;
  }

  .partner-contact__field input {
    min-height: 48px;
    padding-inline: 14px;
  }

  .partner-contact__field textarea {
    min-height: 156px;
    padding: 12px 14px;
    resize: vertical;
  }

  .partner-contact__field input:focus-visible,
  .partner-contact__field textarea:focus-visible {
    border-color: var(--editorial-color-action-border-hover);
    outline: 2px solid var(--editorial-color-accent);
    outline-offset: 2px;
  }

  .partner-contact__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .partner-contact__actions button {
    min-height: 48px;
    padding-inline: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--editorial-color-action-border);
    background: var(--editorial-color-action-surface);
    color: var(--editorial-color-action-text);
    font-family: var(--editorial-font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 20px;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .partner-contact__actions button:hover,
  .partner-contact__actions button:focus-visible {
    background: var(--editorial-color-action-surface-hover);
    border-color: var(--editorial-color-action-border-hover);
    transform: translateY(-1px);
  }

  .partner-contact__actions button:disabled {
    cursor: wait;
    opacity: 0.62;
    transform: none;
  }

  .partner-contact__actions button:focus-visible {
    outline: 2px solid var(--editorial-color-accent);
    outline-offset: 4px;
  }

  .partner-contact__actions p {
    margin: 0;
    color: #6a675e;
    font-family: var(--editorial-font-sans);
    font-size: 15px;
    line-height: 22px;
  }

  .partner-contact__actions p[data-state="success"] {
    color: #315f48;
  }

  .partner-contact__actions p[data-state="error"] {
    color: #8b3f36;
  }

  .partner-contact__actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--editorial-color-text);
    font-family: var(--editorial-font-sans);
    text-underline-offset: 4px;
  }

  @media (max-width: 900px) {
    .partner-contact__body {
      padding: var(--editorial-panel-padding-mobile);
    }

    .partner-contact__form {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .partner-contact__field input {
      min-height: 48px;
    }

    .partner-contact__field textarea {
      height: 144px;
      min-height: 144px;
    }

    .partner-contact__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .partner-contact__actions button {
      min-height: 48px;
    }
  }

  @media (max-width: 560px) {
    .partner-contact__actions button {
      width: 100%;
    }
  }
</style>
