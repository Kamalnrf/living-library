---
import EditorialFrame from "../editorial/EditorialFrame.astro";
import EditorialQuoteGridBlock from "../editorial/EditorialQuoteGridBlock.astro";
import EditorialSectionIntro from "../editorial/EditorialSectionIntro.astro";
import LandingInstagramEmbed from "../landing/LandingInstagramEmbed.astro";
import { FEEDBACK_QUOTES_BLOCK } from "../landing/feedbackData";
import {
  INSTAGRAM_EMBED_URL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_PROFILE_NAME,
  INSTAGRAM_URL,
} from "../../utils/site";

const intro = {
  eyebrow: "02 / VOICES FROM THE ROOM",
  title: "What listeners take with them",
  description:
    "Reflections from participant feedback, alongside recent moments from our sessions.",
} as const;
---

<EditorialFrame
  as="section"
  variant="section"
  id="partner-voices"
  class="partner-section partner-voices"
  aria-labelledby="partner-voices-title"
>
  <EditorialSectionIntro intro={intro} headingId="partner-voices-title" />

  <div class="partner-voices__body">
    <aside
      class="partner-voices__media"
      aria-label="Recent session media on Instagram"
    >
      <div class="partner-voices__media-intro">
        <h3>See what happens in the room</h3>
        <p>
          Follow session moments, Living Story introductions, and event updates
          on Instagram.
        </p>
      </div>

      <LandingInstagramEmbed
        embedUrl={INSTAGRAM_EMBED_URL}
        handle={INSTAGRAM_HANDLE}
        profileName={INSTAGRAM_PROFILE_NAME}
        profileUrl={INSTAGRAM_URL}
      />
    </aside>

    <EditorialQuoteGridBlock
      block={FEEDBACK_QUOTES_BLOCK}
      class="partner-voices__quotes"
    />
  </div>
</EditorialFrame>

<style>
  :global(.partner-voices) {
    background: var(--editorial-color-surface-elevated);
    border: 1px solid var(--editorial-color-border);
  }

  .partner-voices__body {
    display: flex;
    flex-direction: column;
  }

  .partner-voices__media-intro p,
  .partner-voices__media-intro h3 {
    margin: 0;
  }

  :global(.partner-voices__quotes) {
    border-top: 1px solid var(--editorial-color-divider);
  }

  .partner-voices__media {
    min-width: 0;
    padding: var(--editorial-panel-padding);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(360px, 1.2fr);
    gap: var(--editorial-panel-padding);
    align-items: start;
    background: #edf3ef;
  }

  .partner-voices__media-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .partner-voices__media-intro h3 {
    max-width: 12ch;
    color: #2b2a25;
    font-family: var(--editorial-font-serif);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.02;
    text-wrap: balance;
  }

  .partner-voices__media-intro > p {
    max-width: 46ch;
    color: #57544d;
    font-family: var(--editorial-font-sans);
    font-size: 16px;
    line-height: 25px;
    text-wrap: pretty;
  }

  :global(.partner-voices .landing-hero__embed) {
    width: 100%;
    max-width: none;
  }

  @media (max-width: 900px) {
    .partner-voices__media {
      grid-template-columns: 1fr;
    }

    .partner-voices__media {
      min-height: 0;
      padding: var(--editorial-panel-padding-mobile);
    }
  }

  @media (max-width: 560px) {
    .partner-voices__media-intro h3 {
      max-width: none;
      font-size: 32px;
      line-height: 1.08;
    }
  }
</style>
