---
import EditorialFrame from "../editorial/EditorialFrame.astro";
import EditorialQuoteGridBlock from "../editorial/EditorialQuoteGridBlock.astro";
import EditorialSectionIntro from "../editorial/EditorialSectionIntro.astro";
import EditorialTestimonialVideo from "../editorial/EditorialTestimonialVideo.astro";
import PartnerImpactPerspectiveChart from "./PartnerImpactPerspectiveChart.astro";
import { PARTNER_IMPACT_SECTION } from "./partnerWithUsData";
import { FEEDBACK_QUOTES_BLOCK } from "../landing/feedbackData";
import {
  TESTIMONIAL_VIDEO_ID,
  TESTIMONIAL_VIDEO_TITLE,
} from "../../utils/site";

const impact = PARTNER_IMPACT_SECTION.blocks[0];
const rating = impact.metrics[0];
const ratingDisplay = rating.value.replace(".0%", "%");

interface Props {
  landing?: boolean;
}

const { landing = false } = Astro.props;
const intro = landing
  ? {
      eyebrow: "03 / FEEDBACK",
      title: "What people carry forward",
      description:
        "Evidence from listener feedback after Living Stories sessions.",
    }
  : PARTNER_IMPACT_SECTION.intro;
const sectionId = landing ? "feedback" : PARTNER_IMPACT_SECTION.id;
const headingId = landing ? "feedback-title" : "partner-impact-title";
---

<EditorialFrame
  as="section"
  variant="section"
  id={sectionId}
  class="partner-section partner-impact"
  aria-labelledby={headingId}
>
  <EditorialSectionIntro intro={intro} headingId={headingId} />

  <div class="partner-impact__body">
    <article class="partner-impact__experience">
      <div class="partner-impact__experience-content">
        <p class="partner-impact__value">{ratingDisplay}</p>
        <h3>{rating.label}</h3>
        <p>of participants rated the experience 4 or 5</p>
      </div>
    </article>

    <div class="partner-impact__corroboration">
      <article class="partner-impact__outcome">
        <div class="partner-impact__outcome-content">
          <div>
            <h3>{impact.perspectiveShift.label}</h3>
            <p>significant + somewhat</p>
          </div>
          <PartnerImpactPerspectiveChart class="partner-impact__chart" />
        </div>
      </article>

      <EditorialTestimonialVideo
        class="partner-impact__video"
        videoId={TESTIMONIAL_VIDEO_ID}
        title={TESTIMONIAL_VIDEO_TITLE}
        captionLabel={impact.topics.label}
        caption={impact.topics.body}
      />
    </div>
  </div>

  {landing && <EditorialQuoteGridBlock block={FEEDBACK_QUOTES_BLOCK} />}
</EditorialFrame>

<style>
  :global(.partner-impact) {
    isolation: isolate;
    background: #fff;
    border: 1px solid var(--editorial-color-border);
  }

  :global(.partner-impact .editorial-section-intro) {
    position: relative;
    z-index: 1;
    background: #fff;
  }

  .partner-impact__body {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(360px, 0.88fr);
    border-bottom: 1px solid var(--editorial-color-divider);
  }

  .partner-impact__experience {
    min-height: 420px;
    padding: var(--editorial-panel-padding);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #f8f6ee;
    border-right: 1px solid var(--editorial-color-divider);
  }

  .partner-impact__outcome h3,
  .partner-impact__outcome p,
  .partner-impact__experience p,
  .partner-impact__experience h3 {
    margin: 0;
  }

  .partner-impact__outcome-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
    align-items: start;
  }

  .partner-impact__outcome h3,
  .partner-impact__experience h3 {
    color: #2b2a25;
    font-family: var(--editorial-font-serif);
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 400;
    line-height: 1.04;
  }

  .partner-impact__outcome-content > div > p,
  .partner-impact__experience-content > p:last-child {
    margin-top: 13px;
    color: #57544d;
    font-size: 15px;
    line-height: 22px;
  }

  .partner-impact__corroboration {
    min-width: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .partner-impact__outcome {
    padding: var(--editorial-panel-padding);
  }

  .partner-impact__outcome {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #edf3ef;
    --impact-chart-size: 148px;
    --impact-chart-inner-size: 78px;
    --impact-chart-surface: #edf3ef;
    --impact-chart-value-size: 29px;
    --impact-chart-gap: 10px;
  }

  :global(.partner-impact__video) {
    border-top: 1px solid var(--editorial-color-divider);
    border-right: 0;
    border-bottom: 0;
    border-left: 0;
  }

  .partner-impact__outcome-content {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .partner-impact__experience-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .partner-impact__value {
    color: #2d4b40;
    font-size: clamp(96px, 11vw, 148px);
    letter-spacing: -0.055em;
    line-height: 0.86;
    font-variant-numeric: tabular-nums;
  }

  .partner-impact__experience h3 {
    margin-top: 28px;
    font-size: clamp(38px, 4.5vw, 58px);
  }

  .partner-impact__outcome h3 {
    font-size: clamp(30px, 3vw, 40px);
  }

  @media (min-width: 901px) {
    .partner-impact__body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .partner-impact__experience {
      min-height: 360px;
      grid-column: 1;
      grid-row: 1;
    }

    .partner-impact__corroboration {
      display: contents;
    }

    .partner-impact__outcome {
      min-height: 360px;
      grid-column: 2;
      grid-row: 1;
    }

    :global(.partner-impact__video) {
      grid-column: 1 / -1;
      grid-row: 2;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(.partner-impact__video .editorial-testimonial-video__player) {
      min-width: 0;
    }

    :global(.partner-impact__video .editorial-testimonial-video__caption) {
      padding: var(--editorial-panel-padding);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      border-left: 1px solid var(--editorial-color-divider);
      background: #fff;
    }

    :global(
      .partner-impact__video .editorial-testimonial-video__caption-label
    ) {
      line-height: 1.45;
    }

    :global(.partner-impact__video .editorial-testimonial-video__caption-text) {
      max-width: 28ch;
      margin: auto;
      color: #2b2a25;
      font-size: clamp(21px, 1.8vw, 26px);
      line-height: 1.22;
      text-wrap: balance;
    }
  }

  @media (max-width: 900px) {
    .partner-impact__body {
      grid-template-columns: 1fr;
    }

    .partner-impact__experience {
      min-height: 320px;
      padding: var(--editorial-panel-padding-mobile);
      border-right: 0;
      border-bottom: 1px solid var(--editorial-color-divider);
    }

    .partner-impact__outcome {
      min-height: 260px;
      padding: var(--editorial-panel-padding-mobile);
    }
  }

  @media (max-width: 560px) {
    .partner-impact__outcome {
      min-height: 0;
      --impact-chart-size: 116px;
      --impact-chart-inner-size: 62px;
      --impact-chart-value-size: 24px;
      --impact-chart-gap: 8px;
    }

    .partner-impact__outcome-content {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 18px;
      align-items: center;
    }

    :global(.partner-impact__chart) {
      justify-self: end;
      align-items: center;
    }

    .partner-impact__experience {
      min-height: 290px;
    }

    .partner-impact__value {
      font-size: clamp(86px, 27vw, 112px);
      line-height: 0.9;
    }

    .partner-impact__experience h3 {
      margin-top: 18px;
      font-size: 38px;
    }

    .partner-impact__outcome h3 {
      font-size: 30px;
    }
  }
</style>
