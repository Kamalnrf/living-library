---
import LandingEditorialFrame from './LandingEditorialFrame.astro'
import {FEEDBACK_AGGREGATE, FEEDBACK_QUOTES, FEEDBACK_SECTION} from './feedbackData'

const perspectiveShiftStyle = `--landing-feedback-ring: ${FEEDBACK_AGGREGATE.snapshot.perspectiveShift.ringGradient};`
---

<LandingEditorialFrame
  as="section"
  variant="section"
  class="landing-section--feedback landing-feedback"
  aria-labelledby="feedback-title"
>
  <div class="landing-feedback__intro">
    <p class="landing-feedback__eyebrow">{FEEDBACK_SECTION.eyebrow}</p>
    <h2 id="feedback-title">{FEEDBACK_SECTION.title}</h2>
    <p class="landing-feedback__body">{FEEDBACK_SECTION.description}</p>
  </div>

  <div class="landing-feedback__quotes">
    {
      FEEDBACK_QUOTES.map((quote) => (
        <article class="landing-feedback__quote" data-feedback-quote={quote.id}>
          <p class="landing-feedback__quote-label">{quote.label}</p>
          <blockquote class="landing-feedback__quote-text">
            <p>{quote.quote}</p>
          </blockquote>
          <p class="landing-feedback__quote-supporting">{quote.supportingCopy}</p>
        </article>
      ))
    }
  </div>

  <div class="landing-feedback__aggregate">
    <div class="landing-feedback__voice">
      <p class="landing-feedback__aggregate-label">{FEEDBACK_AGGREGATE.voice.eyebrow}</p>
      <h3 class="landing-feedback__voice-title">{FEEDBACK_AGGREGATE.voice.title}</h3>
      <p class="landing-feedback__voice-body">{FEEDBACK_AGGREGATE.voice.description}</p>

      <div class="landing-feedback__voice-quote-wrap">
        <blockquote class="landing-feedback__voice-quote">
          <p class="landing-feedback__voice-quote-label">{FEEDBACK_AGGREGATE.voice.quoteLabel}</p>
          <p class="landing-feedback__voice-quote-text">{FEEDBACK_AGGREGATE.voice.quote}</p>
          <span class="landing-feedback__voice-quote-dot" aria-hidden="true"></span>
        </blockquote>
      </div>
    </div>

    <div class="landing-feedback__snapshot">
      <p class="landing-feedback__aggregate-label">{FEEDBACK_AGGREGATE.snapshot.eyebrow}</p>

      <div class="landing-feedback__snapshot-card">
        <div class="landing-feedback__snapshot-main">
          <div class="landing-feedback__snapshot-shift">
            <p class="landing-feedback__snapshot-shift-label">
              {FEEDBACK_AGGREGATE.snapshot.perspectiveShift.label}
            </p>
            <div class="landing-feedback__snapshot-ring" style={perspectiveShiftStyle}>
              <div class="landing-feedback__snapshot-ring-inner">
                <span class="landing-feedback__snapshot-ring-value">
                  {FEEDBACK_AGGREGATE.snapshot.perspectiveShift.value}
                </span>
              </div>
            </div>
            <div class="landing-feedback__snapshot-legend">
              {
                FEEDBACK_AGGREGATE.snapshot.perspectiveShift.legend.map((item) => (
                  <div class="landing-feedback__snapshot-legend-item">
                    <span
                      class="landing-feedback__snapshot-legend-dot"
                      style={`--landing-feedback-legend-color: ${item.color};`}
                      aria-hidden="true"
                    ></span>
                    <span class="landing-feedback__snapshot-legend-label">{item.label}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="landing-feedback__snapshot-metrics">
            {
              FEEDBACK_AGGREGATE.snapshot.metrics.map((metric) => (
                <div class="landing-feedback__snapshot-metric">
                  <div class="landing-feedback__snapshot-metric-head">
                    <span>{metric.label}</span>
                    <span>{metric.value}</span>
                  </div>
                  <div class="landing-feedback__snapshot-meter">
                    <span
                      class="landing-feedback__snapshot-meter-fill"
                      style={`--landing-feedback-meter-fill-width: ${metric.fillWidth}; --landing-feedback-meter-fill-color: ${metric.fillColor};`}
                    ></span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="landing-feedback__snapshot-topics">
          <p class="landing-feedback__snapshot-topics-label">
            {FEEDBACK_AGGREGATE.snapshot.topics.label}
          </p>
          <p class="landing-feedback__snapshot-topics-body">
            {FEEDBACK_AGGREGATE.snapshot.topics.body}
          </p>
        </div>
      </div>
    </div>
  </div>
</LandingEditorialFrame>

<style>
  :global(.landing-section--feedback) {
    position: relative;
    margin-top: 32px;
  }

  :global(.landing-feedback) {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--landing-border);
  }

  .landing-feedback__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 34px;
    border-bottom: 1px solid var(--landing-section-divider);
  }

  .landing-feedback__eyebrow,
  .landing-feedback__quote-label {
    margin: 0;
    color: #8e8776;
    font-family: var(--landing-font-sans);
    letter-spacing: 0.08em;
  }

  .landing-feedback__eyebrow {
    font-size: 13px;
    line-height: 16px;
  }

  .landing-feedback__intro h2 {
    margin: 0;
    color: var(--landing-text);
    font-family: var(--landing-font-sans);
    font-size: 56px;
    font-weight: 400;
    line-height: 1;
  }

  .landing-feedback__body {
    margin: 0;
    color: #3e3d38;
    font-size: 18px;
    line-height: 1.5;
  }

  .landing-feedback__quotes {
    display: flex;
    min-height: 420px;
    border-bottom: 1px solid var(--landing-section-divider);
  }

  .landing-feedback__quotes > * {
    width: 50%;
  }

  .landing-feedback__quotes > :first-child {
    border-right: 1px solid var(--landing-section-divider);
  }

  .landing-feedback__quote {
    min-width: 0;
    padding: 34px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .landing-feedback__quote-label {
    font-size: 12px;
    line-height: 16px;
  }

  .landing-feedback__quote-text,
  .landing-feedback__quote-supporting,
  .landing-feedback__quote-text p {
    margin: 0;
  }

  .landing-feedback__quote-text {
    color: #2e2d28;
    font-family: var(--landing-font-serif);
    font-size: 40px;
    line-height: 1.08;
  }

  .landing-feedback__quote-supporting {
    color: #3e3d38;
    font-size: 18px;
    line-height: 1.45;
  }

  .landing-feedback__aggregate {
    display: flex;
    min-height: 560px;
  }

  .landing-feedback__aggregate > * {
    min-width: 0;
  }

  .landing-feedback__voice {
    position: relative;
    width: 38%;
    padding: 34px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-right: 1px solid var(--landing-section-divider);
  }

  .landing-feedback__aggregate-label {
    margin: 0;
    color: #8e8776;
    font-family: var(--landing-font-sans);
    font-size: 13px;
    line-height: 16px;
    letter-spacing: 0.08em;
  }

  .landing-feedback__voice-title {
    margin: 0;
    color: #26251f;
    font-family: var(--landing-font-sans);
    font-size: 56px;
    font-weight: 400;
    line-height: 0.96;
  }

  .landing-feedback__voice-body {
    margin: 0;
    color: #3e3d38;
    font-size: 18px;
    line-height: 1.5;
  }

  .landing-feedback__voice-quote-wrap {
    width: 100%;
  }

  .landing-feedback__voice-quote {
    position: absolute;
    top: 329px;
    left: 105px;
    width: 317px;
    margin: 0;
    padding: 14px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid var(--landing-quote-border);
    background: #fff;
  }

  .landing-feedback__voice-quote-label {
    margin: 0;
    color: #00c8e9;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
  }

  .landing-feedback__voice-quote-text {
    margin: 0;
    color: #66655f;
    font-size: 13px;
    line-height: 16px;
  }

  .landing-feedback__voice-quote-dot {
    position: absolute;
    top: -10px;
    left: -12px;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: #fa8b44;
  }

  .landing-feedback__snapshot {
    width: 62%;
    padding: 34px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    background: #f8f6ee;
  }

  .landing-feedback__snapshot-card {
    width: 100%;
    min-height: 368px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border: 1px solid #d5cebd;
    background: #fbfaf6;
  }

  .landing-feedback__snapshot-main {
    width: 100%;
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .landing-feedback__snapshot-shift {
    width: 42%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .landing-feedback__snapshot-shift-label {
    margin: 0;
    color: #2f2d28;
    font-size: 24px;
    line-height: 28px;
  }

  .landing-feedback__snapshot-ring {
    width: 186px;
    height: 186px;
    border-radius: 999px;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: var(
      --landing-feedback-ring,
      conic-gradient(from 0deg, #5e9a83 0% 40%, #c5ae6d 40% 75.7%, #ece7dd 75.7% 100%)
    );
  }

  .landing-feedback__snapshot-ring-inner {
    width: 96px;
    height: 96px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fbfaf6;
  }

  .landing-feedback__snapshot-ring-value {
    color: #2f2d28;
    font-size: 35px;
    line-height: 48px;
  }

  .landing-feedback__snapshot-legend {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .landing-feedback__snapshot-legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .landing-feedback__snapshot-legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    flex: 0 0 auto;
    background: var(--landing-feedback-legend-color, #5e9a83);
  }

  .landing-feedback__snapshot-legend-label {
    color: #6a675e;
    font-size: 12px;
    line-height: 16px;
  }

  .landing-feedback__snapshot-metrics {
    width: 58%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  .landing-feedback__snapshot-metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .landing-feedback__snapshot-metric-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #35332d;
    font-size: 17px;
    line-height: 22px;
  }

  .landing-feedback__snapshot-meter {
    width: 100%;
    height: 10px;
    border-radius: 999px;
    overflow: clip;
    background: #e8e2d7;
  }

  .landing-feedback__snapshot-meter-fill {
    display: block;
    width: var(--landing-feedback-meter-fill-width, 0%);
    height: 100%;
    background: var(--landing-feedback-meter-fill-color, #6fa06e);
  }

  .landing-feedback__snapshot-topics {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    border: 1px solid var(--landing-border);
    background: #fff;
  }

  .landing-feedback__snapshot-topics-label {
    margin: 0;
    color: #8a8477;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.05em;
  }

  .landing-feedback__snapshot-topics-body {
    margin: 0;
    color: #35332d;
    font-size: 18px;
    line-height: 24px;
  }

  @media (max-width: 900px) {
    :global(.landing-section--feedback) {
      margin-top: 24px;
    }

    .landing-feedback__intro {
      gap: 12px;
    }

    .landing-feedback__eyebrow {
      font-size: 11px;
      line-height: 14px;
      letter-spacing: 0.11em;
    }

    .landing-feedback__intro h2 {
      font-size: 44px;
      line-height: 44px;
    }

    .landing-feedback__body {
      font-size: 16px;
      line-height: 25px;
    }

    .landing-feedback__quotes {
      min-height: 0;
      flex-direction: column;
    }

    .landing-feedback__quotes > * {
      width: 100%;
    }

    .landing-feedback__quotes > :first-child {
      border-right: 0;
      border-bottom: 1px solid var(--landing-section-divider);
    }

    .landing-feedback__quote-text {
      font-size: 34px;
      line-height: 36px;
    }

    .landing-feedback__quote-supporting {
      font-size: 16px;
      line-height: 25px;
    }

    .landing-feedback__aggregate {
      min-height: 0;
      flex-direction: column;
    }

    .landing-feedback__voice,
    .landing-feedback__snapshot {
      width: 100%;
    }

    .landing-feedback__voice {
      border-right: 0;
      border-bottom: 1px solid var(--landing-section-divider);
    }

    .landing-feedback__voice-title {
      font-size: 44px;
      line-height: 44px;
    }

    .landing-feedback__voice-body {
      font-size: 16px;
      line-height: 25px;
    }

    .landing-feedback__voice-quote-wrap {
      padding-top: 8px;
    }

    .landing-feedback__voice-quote {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      max-width: 100%;
    }

    .landing-feedback__snapshot-card {
      min-height: 0;
      gap: 14px;
    }

    .landing-feedback__snapshot-main {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .landing-feedback__snapshot-shift,
    .landing-feedback__snapshot-metrics {
      width: 100%;
    }

    .landing-feedback__snapshot-shift-label {
      font-size: 22px;
      line-height: 28px;
    }

    .landing-feedback__snapshot-ring {
      width: 160px;
      height: 160px;
    }

    .landing-feedback__snapshot-ring-inner {
      width: 84px;
      height: 84px;
    }

    .landing-feedback__snapshot-ring-value {
      font-size: 30px;
      line-height: 36px;
    }

    .landing-feedback__snapshot-metric-head {
      font-size: 15px;
      line-height: 20px;
    }

    .landing-feedback__snapshot-topics-body {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
