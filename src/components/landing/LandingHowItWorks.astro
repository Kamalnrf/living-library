---
import EditorialFrame from '../editorial/EditorialFrame.astro'
import {HOW_IT_WORKS_SECTION, HOW_IT_WORKS_STEPS} from './howItWorksData'
---

<EditorialFrame
  as="section"
  variant="section"
  id="how-it-works"
  class="landing-section--how-it-works landing-how-it-works"
  aria-labelledby="how-it-works-title"
>
  <div class="landing-how-it-works__intro">
    <p class="landing-how-it-works__eyebrow">{HOW_IT_WORKS_SECTION.eyebrow}</p>
    <h2 id="how-it-works-title">{HOW_IT_WORKS_SECTION.title}</h2>
    <p class="landing-how-it-works__body landing-how-it-works__body--desktop">
      {HOW_IT_WORKS_SECTION.description.desktop}
    </p>
    <p class="landing-how-it-works__body landing-how-it-works__body--mobile">
      {HOW_IT_WORKS_SECTION.description.mobile}
    </p>
  </div>

  {
    HOW_IT_WORKS_STEPS.map((step) => {
      const quoteStyles =
        step.quote &&
        [
          `--landing-step-quote-offset: ${step.quote.desktopOffset}`,
          `--landing-step-quote-top: ${step.quote.desktopTop}`,
          `--landing-step-quote-max-width: ${step.quote.desktopMaxWidth}`,
        ].join('; ')

      const renderText = (
        <div class="landing-how-it-works__column landing-how-it-works__column--text" style={quoteStyles}>
          <p class="landing-how-it-works__step-label">{step.stepLabel}</p>
          <h3>{step.title}</h3>
          <p class="landing-how-it-works__step-body">{step.description}</p>

          {
            step.quote && (
              <figure class="landing-how-it-works__quote">
                <span class="landing-how-it-works__quote-dot" aria-hidden="true"></span>
                <figcaption class="landing-how-it-works__quote-speaker">{step.quote.speaker}</figcaption>

                <blockquote class="landing-how-it-works__quote-text">
                  <p>{step.quote.text}</p>
                </blockquote>
              </figure>
            )
          }
        </div>
      )

      const renderMedia =
        step.media.kind === 'single' ? (
          <div class="landing-how-it-works__column landing-how-it-works__column--media">
            <figure
              class:list={[
                'landing-how-it-works__media-frame',
                step.media.frameTone === 'sage'
                  ? 'landing-how-it-works__media-frame--sage'
                  : 'landing-how-it-works__media-frame--lavender',
              ]}
              style={`--landing-step-media-height: ${step.media.desktopHeight}; --landing-step-media-height-mobile: ${step.media.mobileHeight};`}
            >
              <img
                class="landing-how-it-works__media-image"
                src={step.media.image.src}
                alt={step.media.image.alt}
                width={step.media.image.width}
                height={step.media.image.height}
                loading="lazy"
              />
            </figure>
          </div>
        ) : (
          <div class="landing-how-it-works__column landing-how-it-works__column--media">
            <div class="landing-how-it-works__collage">
              <div class="landing-how-it-works__collage-stack">
                {step.media.stackedImages.map((image) => (
                  <figure class="landing-how-it-works__collage-panel">
                    <img
                      class="landing-how-it-works__media-image"
                      src={image.src}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      loading="lazy"
                    />
                  </figure>
                ))}
              </div>

              <figure class="landing-how-it-works__media-frame landing-how-it-works__media-frame--sand">
                <img
                  class="landing-how-it-works__media-image"
                  src={step.media.accentImage.src}
                  alt={step.media.accentImage.alt}
                  width={step.media.accentImage.width}
                  height={step.media.accentImage.height}
                  loading="lazy"
                />
              </figure>
            </div>
          </div>
        )

      return (
        <article class="landing-how-it-works__row">
          {step.layout === 'media-first' ? [renderMedia, renderText] : [renderText, renderMedia]}
        </article>
      )
    })
  }
</EditorialFrame>

<style>
  :global(.landing-section--how-it-works) {
    position: relative;
    margin-top: 32px;
    scroll-margin-top: 6rem;
  }

  :global(.landing-how-it-works) {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--landing-border);
  }

  .landing-how-it-works__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 34px;
    border-bottom: 1px solid var(--landing-section-divider);
  }

  .landing-how-it-works__eyebrow,
  .landing-how-it-works__step-label {
    margin: 0;
    color: #8e8776;
    letter-spacing: 0.08em;
  }

  .landing-how-it-works__eyebrow {
    font-size: 13px;
    line-height: 16px;
  }

  .landing-how-it-works__intro h2 {
    margin: 8px 0 0;
    font-family: var(--landing-font-sans);
    font-size: 56px;
    font-weight: 400;
    line-height: 1;
    color: #252520;
  }

  .landing-how-it-works__body {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: #3e3d38;
  }

  .landing-how-it-works__body--mobile {
    display: none;
  }

  .landing-how-it-works__row {
    display: flex;
    min-height: 450px;
    border-bottom: 1px solid var(--landing-section-divider);
  }

  .landing-how-it-works__row:last-child {
    border-bottom: 0;
  }

  .landing-how-it-works__row > * {
    width: 50%;
  }

  .landing-how-it-works__row > :first-child {
    border-right: 1px solid var(--landing-section-divider);
  }

  .landing-how-it-works__column {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 34px;
  }

  .landing-how-it-works__column--text {
    position: relative;
  }

  .landing-how-it-works__step-label {
    font-size: 12px;
    line-height: 16px;
  }

  .landing-how-it-works__column h3 {
    margin: 0;
    font-family: var(--landing-font-sans);
    font-size: 44px;
    font-weight: 400;
    line-height: 1;
    color: #252520;
  }

  .landing-how-it-works__step-body {
    margin: 0;
    font-size: 18px;
    line-height: 1.45;
    color: #3e3d38;
  }

  .landing-how-it-works__media-frame {
    position: relative;
    width: 100%;
    height: var(--landing-step-media-height, 381px);
    margin: 0;
    overflow: hidden;
    border: 1px solid transparent;
  }

  .landing-how-it-works__media-frame--sage {
    border-color: #c8d8d0;
    background:
      radial-gradient(circle farthest-corner at 10% 0%, rgb(203 229 220 / 0.32) 0%, transparent 72%),
      linear-gradient(135deg, #f1f5f0 0%, #eef1ed 55%, #f6f7f3 100%);
  }

  .landing-how-it-works__media-frame--sand {
    border-color: #d7cbb7;
    background:
      radial-gradient(circle farthest-corner at 86% 10%, rgb(224 206 175 / 0.28) 0%, transparent 70%),
      linear-gradient(135deg, #f1eee6 0%, #ece6db 56%, #f4f1e8 100%);
  }

  .landing-how-it-works__media-frame--lavender {
    border-color: #cdc7de;
    background:
      radial-gradient(circle farthest-corner at 14% 0%, rgb(197 191 230 / 0.32) 0%, transparent 72%),
      linear-gradient(135deg, #f0eef6 0%, #ebebf3 58%, #f5f4f8 100%);
  }

  .landing-how-it-works__media-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .landing-how-it-works__collage {
    display: grid;
    grid-template-columns: minmax(0, 344fr) minmax(0, 165fr);
    gap: 16px;
    width: 100%;
    height: 381px;
  }

  .landing-how-it-works__collage-stack {
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 8px;
    min-width: 0;
  }

  .landing-how-it-works__collage-panel {
    min-width: 0;
    margin: 0;
    overflow: hidden;
  }

  .landing-how-it-works__collage .landing-how-it-works__media-frame {
    height: 100%;
  }

  .landing-how-it-works__quote {
    position: absolute;
    top: var(--landing-step-quote-top, auto);
    left: var(--landing-step-quote-offset, 0px);
    width: min(
      var(--landing-step-quote-max-width, 261px),
      calc(100% - var(--landing-step-quote-offset, 0px) - 1rem)
    );
    margin: 0;
    padding: 8px 10px;
    border: 1px solid var(--landing-quote-border);
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .landing-how-it-works__quote-dot {
    position: absolute;
    top: -10px;
    left: -12px;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: #fa8b44;
  }

  .landing-how-it-works__quote-speaker {
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    color: #00c8e9;
  }

  .landing-how-it-works__quote-text {
    margin: 0;
  }

  .landing-how-it-works__quote-text p {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    color: #66655f;
  }

  @media (max-width: 900px) {
    :global(.landing-section--how-it-works) {
      margin-top: 24px;
    }

    .landing-how-it-works__intro {
      gap: 12px;
    }

    .landing-how-it-works__eyebrow {
      font-size: 11px;
      line-height: 14px;
      letter-spacing: 0.11em;
    }

    .landing-how-it-works__intro h2 {
      margin-top: 0;
      font-size: 44px;
      line-height: 44px;
    }

    .landing-how-it-works__body--desktop {
      display: none;
    }

    .landing-how-it-works__body--mobile {
      display: block;
      font-size: 16px;
      line-height: 25px;
    }

    .landing-how-it-works__row {
      min-height: 0;
      flex-direction: column;
    }

    .landing-how-it-works__row > * {
      width: 100%;
    }

    .landing-how-it-works__row > :first-child {
      border-right: 0;
      border-bottom: 1px solid var(--landing-section-divider);
    }

    .landing-how-it-works__column h3 {
      font-size: 36px;
      line-height: 36px;
    }

    .landing-how-it-works__step-body {
      font-size: 16px;
      line-height: 25px;
    }

    .landing-how-it-works__media-frame {
      height: var(--landing-step-media-height-mobile, 228px);
    }

    .landing-how-it-works__collage {
      grid-template-columns: 1fr;
      gap: 12px;
      height: auto;
    }

    .landing-how-it-works__collage-stack {
      height: 220px;
    }

    .landing-how-it-works__collage .landing-how-it-works__media-frame {
      height: 220px;
    }

    .landing-how-it-works__quote {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      margin-top: 8px;
      gap: 6px;
    }

    .landing-how-it-works__quote-dot {
      top: -11px;
      left: -11px;
    }

    .landing-how-it-works__quote-text p {
      font-size: 12px;
    }
  }
</style>
