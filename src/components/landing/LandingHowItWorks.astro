---
import EditorialFrame from '../editorial/EditorialFrame.astro'
import EditorialSectionBlocks from '../editorial/EditorialSectionBlocks.astro'
import EditorialSectionIntro from '../editorial/EditorialSectionIntro.astro'
import {HOW_IT_WORKS_SECTION} from './howItWorksData'
---

<EditorialFrame
  as="section"
  variant="section"
  id="how-it-works"
  class="landing-section--how-it-works landing-how-it-works"
  aria-labelledby="how-it-works-title"
>
  <EditorialSectionIntro
    intro={HOW_IT_WORKS_SECTION.intro}
    headingId="how-it-works-title"
    style="--editorial-section-intro-title-margin-top: 8px; --editorial-section-intro-title-margin-top-mobile: 0px;"
  />
  <EditorialSectionBlocks blocks={HOW_IT_WORKS_SECTION.blocks} headingTag="h3" />
</EditorialFrame>

<style>
  :global(.landing-section--how-it-works) {
    position: relative;
    margin-top: 32px;
    scroll-margin-top: 6rem;
  }

  :global(.landing-how-it-works) {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--editorial-color-border);
  }

  :global(
    .landing-how-it-works [data-editorial-block-id='borrow-a-living-book'] .editorial-story-row__quote
  ) {
    position: absolute;
    top: 256px;
    left: 78px;
    width: min(261px, calc(100% - 78px - 1rem));
    margin-top: 0;
  }

  :global(
    .landing-how-it-works
      [data-editorial-block-id='return-with-a-changed-perspective']
      .editorial-story-row__quote
  ) {
    position: absolute;
    top: 301px;
    left: 154px;
    width: min(232px, calc(100% - 154px - 1rem));
    margin-top: 0;
  }

  @media (max-width: 900px) {
    :global(.landing-section--how-it-works) {
      margin-top: 24px;
    }

    :global(
      .landing-how-it-works [data-editorial-block-id='borrow-a-living-book'] .editorial-story-row__quote,
      .landing-how-it-works
        [data-editorial-block-id='return-with-a-changed-perspective']
        .editorial-story-row__quote
    ) {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      max-width: 100%;
      margin-top: 8px;
    }
  }
</style>
