---
import LandingPageShell from '../../layouts/LandingPageShell.astro'
import LandingHeader from './LandingHeader.astro'
import LandingHero from './LandingHero.astro'
import LandingUpcomingSessions from './LandingUpcomingSessions.astro'
import LandingHowItWorks from './LandingHowItWorks.astro'
import {HOME_DESCRIPTION, HOME_TITLE} from '../../utils/site'
---

<LandingPageShell
  title={HOME_TITLE}
  description={HOME_DESCRIPTION}
>
  <LandingHeader slot="header" />

  <LandingHero />
  <LandingUpcomingSessions />
  <LandingHowItWorks />
  <div class="landing-anchor-rail" aria-hidden="true">
    <div id="get-involved" class="landing-anchor-target"></div>
    <div id="contact" class="landing-anchor-target"></div>
  </div>
</LandingPageShell>
