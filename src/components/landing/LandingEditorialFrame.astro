---
interface Props {
  as?: 'div' | 'header' | 'section' | 'footer'
  variant?: 'artboard' | 'section' | 'shell'
  class?: string
  id?: string
  ['aria-labelledby']?: string
}

const {
  as: Tag = 'div',
  variant = 'section',
  class: className,
  ...rest
}: Props = Astro.props
---

<Tag
  class:list={['landing-editorial-frame', `landing-editorial-frame--${variant}`, className]}
  {...rest}
>
  <slot />
</Tag>
