---
import LandingEditorialFrame from './LandingEditorialFrame.astro'
import {SITE_NAME} from '../../utils/site'

type NavigationItem = {
  href: `#${string}`
  label: string
  emphasized?: boolean
}

const navigationItems: readonly NavigationItem[] = [
  {href: '#how-it-works', label: 'how it works'},
  {href: '#get-involved', label: 'partner with us', emphasized: true},
  {href: '#contact', label: 'contact'},
]
---

<LandingEditorialFrame as="header" variant="shell" class="landing-header" id="landing-page-top">
  <div class="landing-header__inner">
    <a class="landing-header__brand" href="#landing-page-top" aria-label={`${SITE_NAME} home`}>
      <img
        class="landing-header__mark"
        src="/images/logo.png"
        alt=""
        width="93"
        height="48"
        loading="eager"
        decoding="async"
      />

      <span class="landing-header__brand-text">{SITE_NAME}</span>
    </a>

    <nav class="landing-header__nav" aria-label="Primary">
      {
        navigationItems.map((item) => (
          <a
            class:list={['landing-header__nav-link', item.emphasized && 'landing-header__nav-link--accent']}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</LandingEditorialFrame>
