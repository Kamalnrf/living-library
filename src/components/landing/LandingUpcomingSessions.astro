---
import EditorialFrame from '../editorial/EditorialFrame.astro'
import {LUMA_CALENDAR_EMBED_URL} from '../../utils/site'

const sectionEyebrow = '01 / JOIN OUR EVENT'
const sectionDescription = 'Browse upcoming events and RSVP'
const participantQuote =
  '"The whole session is really worthy and every story we heard today will change our perception."'
---

<EditorialFrame
  as="section"
  variant="section"
  id="upcoming-sessions"
  class="landing-section--upcoming"
  aria-labelledby="upcoming-sessions-title"
>
  <div class="landing-upcoming">
    <div class="landing-upcoming__content">
      <div class="landing-upcoming__copy-stack">
        <p class="landing-upcoming__eyebrow">{sectionEyebrow}</p>

        <div class="landing-upcoming__intro">
          <h2 id="upcoming-sessions-title">Upcoming sessions</h2>
          <p class="landing-upcoming__body">{sectionDescription}</p>
        </div>
      </div>

      <figure class="landing-upcoming__quote">
        <figcaption class="landing-upcoming__quote-speaker">Participant</figcaption>

        <blockquote class="landing-upcoming__quote-text">
          <p>{participantQuote}</p>
        </blockquote>
      </figure>
    </div>

    <div class="landing-upcoming__calendar-column">
      <div class="landing-upcoming__calendar-shell">
        <iframe
          class="landing-upcoming__calendar-frame"
          src={LUMA_CALENDAR_EMBED_URL}
          title="Living Stories Collective upcoming sessions"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</EditorialFrame>

<style>
  .landing-section--upcoming {
    position: relative;
    margin-top: -1px;
    scroll-margin-top: 6rem;
  }

  .landing-upcoming {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: #fff;
    border: 1px solid var(--editorial-color-border);
  }

  .landing-upcoming__content {
    min-width: 0;
    padding: 34px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-right: 1px solid var(--editorial-color-divider);
  }

  .landing-upcoming__copy-stack {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 92px;
  }

  .landing-upcoming__eyebrow {
    margin: 0;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.12em;
    color: #8a8477;
  }

  .landing-upcoming__intro {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .landing-upcoming__intro h2 {
    margin: 0;
    max-width: 6ch;
    font-family: var(--editorial-font-serif);
    font-size: 62px;
    font-weight: 400;
    line-height: 60px;
    color: #b4510a;
  }

  .landing-upcoming__body {
    margin: 0;
    max-width: 311px;
    font-size: 20px;
    line-height: 31px;
    color: #37352f;
  }

  .landing-upcoming__body::after {
    content: '.';
  }

  .landing-upcoming__quote {
    position: relative;
    width: min(340px, calc(100% - 4rem));
    margin: 0;
    margin-top: auto;
    margin-left: clamp(4rem, 18%, 6.25rem);
    padding: 8px 10px;
    border: 1px solid var(--editorial-color-quote-border);
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .landing-upcoming__quote::before {
    content: '';
    position: absolute;
    top: -10px;
    left: -12px;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: #fa8b44;
  }

  .landing-upcoming__quote-speaker {
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    color: #00c8e9;
  }

  .landing-upcoming__quote-text {
    margin: 0;
  }

  .landing-upcoming__quote-text p {
    margin: 0;
    font-size: 13px;
    line-height: 16px;
    color: #66655f;
  }

  .landing-upcoming__calendar-column {
    min-width: 0;
    padding: 34px;
    display: flex;
  }

  .landing-upcoming__calendar-shell {
    position: relative;
    width: 100%;
    flex: 1;
    height: 500px;
    overflow: hidden;
    border: 1px solid var(--editorial-color-widget-border);
    background-color: var(--editorial-color-widget-surface);
    background-image:
      radial-gradient(circle farthest-corner at 0% 0%, rgb(233 231 225 / 0.8) 0%, transparent 76%),
      linear-gradient(180deg, #f5f3ed 0%, #efede6 100%);
  }

  .landing-upcoming__calendar-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
  }

  @media (max-width: 900px) {
    .landing-upcoming {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .landing-upcoming__content {
      padding: 34px;
      border-right: 0;
      border-bottom: 1px solid var(--editorial-color-divider);
    }

    .landing-upcoming__copy-stack {
      gap: 26px;
    }

    .landing-upcoming__eyebrow {
      font-size: 11px;
      line-height: 14px;
    }

    .landing-upcoming__intro {
      gap: 14px;
    }

    .landing-upcoming__intro h2 {
      font-size: 52px;
      line-height: 50px;
    }

    .landing-upcoming__body {
      max-width: 261px;
      font-size: 17px;
      line-height: 27px;
    }

    .landing-upcoming__body::after {
      content: '';
    }

    .landing-upcoming__quote {
      width: 100%;
      margin-top: 8px;
      margin-left: 0;
      gap: 6px;
    }

    .landing-upcoming__quote::before {
      top: -12px;
      left: -11px;
    }

    .landing-upcoming__quote-text p {
      font-size: 12px;
    }

    .landing-upcoming__calendar-column {
      padding: 34px;
    }

    .landing-upcoming__calendar-shell {
      height: 450px;
    }
  }
</style>
